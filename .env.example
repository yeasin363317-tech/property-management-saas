# Supabase project URL and the PUBLISHABLE (anon) key only.
# NEVER put a service_role / secret key here: anything starting with VITE_ is public in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Optional: password of the public DEMO accounts (fake sample data only). Leave empty to hide the "Try demo" buttons.
# Must equal the password you passed to: select public.seed_demo('...');
VITE_DEMO_PASSWORD=
