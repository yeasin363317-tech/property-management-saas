# Supabase project URL and the PUBLISHABLE (anon) key only.
# NEVER put a service_role / secret key here: anything starting with VITE_ is public in the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Optional: 12+ character password for the public DEMO accounts (fake sample data only).
# It must equal the password passed to: select public.seed_demo('...');
# Leave empty (or shorter than 12 characters) to hide the "Try demo" buttons.
VITE_DEMO_PASSWORD=
